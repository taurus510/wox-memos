{
  "Id": "f4940655-b86d-4551-a07b-6da8b8ecdde9",
  "Name": "Memos",
  "Description": "i18n:plugin_description",
  "Author": "taurus510",
  "Website": "https://github.com/taurus510/wox-memos",
  "Version": "1.0.0",
  "MinWoxVersion": "2.0.0",
  "Runtime": "NODEJS",
  "Entry": "index.js",
  "Icon": "emoji:📝",
  "TriggerKeywords": ["memos", "memo"],
  "SupportedOS": ["Windows", "Darwin", "Linux"],
  "Commands": [
    { "Command": "create", "Description": "i18n:command_create_desc" },
    { "Command": "check", "Description": "i18n:command_check_desc" }
  ],
  "Features": [
    { "Name": "ignoreAutoScore", "Params": {} },
    { "Name": "debounce", "Params": { "IntervalMs": 250 } }
  ],
  "SettingDefinitions": [
    {
      "Type": "textbox",
      "Value": {
        "Key": "host",
        "Label": "i18n:setting_host_label",
        "Tooltip": "i18n:setting_host_tooltip",
        "DefaultValue": "http://192.168.0.14:5230",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [{ "Type": "not_empty", "Value": {} }],
        "Style": { "Width": 400 }
      },
      "DisabledInPlatforms": [],
      "IsPlatformSpecific": false
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "token",
        "Label": "i18n:setting_token_label",
        "Tooltip": "i18n:setting_token_tooltip",
        "DefaultValue": "",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [{ "Type": "not_empty", "Value": {} }],
        "Style": { "Width": 400 }
      },
      "DisabledInPlatforms": [],
      "IsPlatformSpecific": false
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "timeoutMs",
        "Label": "i18n:setting_timeout_label",
        "Tooltip": "i18n:setting_timeout_tooltip",
        "DefaultValue": "10000",
        "Suffix": "ms",
        "MaxLines": 1,
        "Validators": [],
        "Style": { "Width": 200 }
      },
      "DisabledInPlatforms": [],
      "IsPlatformSpecific": false
    }
  ],
